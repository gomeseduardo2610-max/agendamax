# Environment variables for AgendaMax SaaS

# JWT Secret Key for Session Encryption
JWT_SECRET="agendamax_super_secret_jwt_key_2026_saas"

# Database Connection URL (PostgreSQL / Supabase)
# For Supabase, copy the connection string from Project Settings -> Database:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
